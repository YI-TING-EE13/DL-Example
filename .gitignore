# =====================================================================
# Deep Learning Training Framework — .gitignore
# =====================================================================

# ── Python bytecode & caches ────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo

# ── Virtual environments (uv / venv / conda) ───────────────────────────
.venv/
venv/
env/
.python-version

# ── uv lock file (regenerated by `uv sync`) ────────────────────────────
# 如果你想固定依賴版本以確保可重現性，可以移除這行
uv.lock

# ── Distribution / Packaging ───────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg

# =====================================================================
# Project-Specific Ignores (專案特定排除項)
# =====================================================================

# ── Downloaded datasets (auto-downloaded on first run) ──────────────────
# MNIST: ~55MB, CIFAR-10: ~170MB
# 這些資料集可由 torchvision 自動下載，不需要納入版本控制
data/

# ── Model checkpoints (saved during training) ──────────────────────────
# 包含 model_best.pt 等檔案，體積可能很大 (數十 MB ~ 數 GB)
checkpoints/

# ── WandB offline run logs ──────────────────────────────────────────────
# wandb/ 目錄包含離線實驗記錄，可事後用 `wandb sync` 上傳
wandb/

# ── Temporary training logs ─────────────────────────────────────────────
train_log.txt

# =====================================================================
# IDE & Editor Files
# =====================================================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Jupyter Notebook ───────────────────────────────────────────────────
.ipynb_checkpoints/
